# Copy to `.env` and fill in real values. NEVER commit the real .env.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-7          # shared default; per-instance config.json overrides
ANTHROPIC_MAX_TOKENS=4096

# --- Brave Search ---
BRAVE_API_KEY=BSAxxxxxxxx

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-xxxxxxxx
SLACK_AGENT_CHANNEL_ID=Cxxxxxxxx         # channel the agent posts to
SLACK_OBSERVER_CHANNEL_ID=Cxxxxxxxx      # silent mirror of every episode
SLACK_BEN_USER_ID=Uxxxxxxxx              # operator's user id (for DMs)

# --- Budgets (shared defaults; per-instance config.json overrides) ---
WEEKLY_BUDGET_USD=300
DAILY_BUDGET_USD=50
SESSION_COST_CAP_USD=20.0

# --- Runtime ---
AGENT_ROOT=/home/youruser/agent
DASHBOARD_PORT=8081
DASHBOARD_HOST=0.0.0.0
MAX_TOOL_CALLS_PER_SESSION=500
MAX_SESSION_WALL_CLOCK_SECONDS=14400
